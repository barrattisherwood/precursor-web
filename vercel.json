{
  "framework": "angular",
  "buildCommand": "npm run build -- --configuration=production",
  "outputDirectory": "dist/precursor-web/browser",
  "installCommand": "npm install",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://precursor-api-production.up.railway.app/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
